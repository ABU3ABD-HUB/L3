protectBtn.Parent = mainFrame

local protectCorner = Instance.new("UICorner")
protectCorner.CornerRadius = UDim.new(0, 8)
protectCorner.Parent = protectBtn

local isSmartProtected = false

protectBtn.MouseButton1Click:Connect(function()
    isSmartProtected = not isSmartProtected
    if isSmartProtected then
        protectBtn.BackgroundColor3 = Color3.fromRGB(30, 60, 40)
        protectBtn.Text = "إيقاف الحماية"
        
        -- الكلمات لـ nightvision و nv
        local blockWords = {"logs", "clogs", "nv", "nightvision", "title", "name", "fling", "noclip", "noclip2", "char"}
        
        -- تنظيف فوري للعناصر الحالية المخالفة
        pcall(function()
            local containers = {player:FindFirstChild("PlayerGui"), player, game:GetService("CoreGui"), replicatedStorage, lighting}
            for _, container in ipairs(containers) do
                if container then
                    for _, obj in ipairs(container:GetDescendants()) do
                        if obj ~= mainFrame and obj ~= toggleBtn and obj ~= welcomeFrame then
                            local nameLower = string.lower(obj.Name)
                            for _, word in ipairs(blockWords) do
                                if string.find(nameLower, word) then
                                    if not obj:IsA("ScreenGui") and not obj:IsA("CoreGui") and not obj:IsA("Folder") then
                                        pcall(function() obj:Destroy() end)
                                    end
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end)

        -- مراقبة ملف NightVision
        local connections = {}
        local function monitor(container)
            if not container then return end
            table.insert(connections, container.DescendantAdded:Connect(function(obj)
                if not isSmartProtected then return end
                if obj == mainFrame or obj == toggleBtn then return end
                pcall(function()
                    local nameLower = string.lower(obj.Name)
                    for _, word in ipairs(blockWords) do
                        if string.find(nameLower, word) then
                            if not obj:IsA("ScreenGui") and not obj:IsA("Folder") then
                                obj:Destroy()
                            end
                            break
                        end
                    end
                end)
            end))
        end

        pcall(function()
            monitor(player:FindFirstChild("PlayerGui"))
            monitor(player)
            monitor(game:GetService("CoreGui"))
            monitor(replicatedStorage)
            monitor(lighting)
        end)

        getgenv().SH_SmartConnections = connections
    else
        protectBtn.BackgroundColor3 = Color3.fromRGB(50, 35, 35)
        protectBtn.Text = "الحماية zara"
        if getgenv().SH_SmartConnections then
            for _, conn in ipairs(getgenv().SH_SmartConnections) do
                pcall(function() conn:Disconnect() end)
            end
            getgenv().SH_SmartConnections = nil
        end
    end
end)

